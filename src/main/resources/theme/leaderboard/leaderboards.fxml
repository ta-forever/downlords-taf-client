<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="leaderboardRoot" alignment="CENTER" maxHeight="1.7976931348623157E308"
      maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" xmlns="http://javafx.com/javafx/8.0.60"
      fx:controller="com.faforever.client.leaderboard.LeaderboardsController">
    <Separator minHeight="10.0"/>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <ComboBox fx:id="modComboBox" styleClass="query-filter"/>
        <ComboBox fx:id="leaderboardComboBox" onAction="#onLeaderboardSelected" styleClass="query-filter"/>
        <ComboBox fx:id="seasonComboBox" onAction="#onSeasonSelected" styleClass="query-filter"
                  visible="false" managed="false"/>
        <CheckBox fx:id="friendsOnlyCheckBox" text="%leaderboard.friendsOnlyOption" onAction="#onLeaderboardSelected"/>
        <Button text="%refresh" onAction="#onLeaderboardSelected"/>
        <Label contentDisplay="RIGHT" graphicTextGap="10.0" maxWidth="1.7976931348623157E308">
            <graphic>
                <Region styleClass="icon,search-icon"/>
            </graphic>
        </Label>
        <TextField fx:id="searchTextField" maxWidth="1.7976931348623157E308"
                   promptText="%ladder.searchPrompt" HBox.hgrow="ALWAYS" styleClass="query-item"/>
    </HBox>
    <VBox fx:id="contentPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0"
          VBox.vgrow="ALWAYS" visible="false">
        <children>
            <TitledPane fx:id="hallOfFameTitledPane" text="%leaderboard.hallOfFame" expanded="false"
                        animated="false" visible="false" managed="false" maxWidth="1.7976931348623157E308">
                <content>
                    <TableView fx:id="hallOfFameTable" prefHeight="220.0" maxWidth="1.7976931348623157E308">
                        <columns>
                            <TableColumn fx:id="hofRankColumn" text="%leaderboard.column.rank"/>
                            <TableColumn fx:id="hofNameColumn" text="%leaderboard.column.name"/>
                            <TableColumn fx:id="hofGoldColumn" text="%leaderboard.hof.gold"/>
                            <TableColumn fx:id="hofSilverColumn" text="%leaderboard.hof.silver"/>
                            <TableColumn fx:id="hofBronzeColumn" text="%leaderboard.hof.bronze"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </content>
            </TitledPane>
            <TableView fx:id="ratingTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                       onContextMenuRequested="#openContextMenu"
                       minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="rankColumn" text="%leaderboard.column.rank"/>
                    <TableColumn fx:id="nameColumn" text="%leaderboard.column.name"/>
                    <TableColumn fx:id="ratingColumn" text="%leaderboard.column.rating"/>
                    <TableColumn fx:id="gamesPlayedColumn" text="%leaderboard.column.numberOfGames"/>
                    <TableColumn fx:id="winRateColumn" text="%leaderboard.column.winRate"/>
                    <TableColumn fx:id="allResultsColumn" text="%leaderboard.column.winDrawLoss"/>
                    <TableColumn fx:id="recentResultsColumn" text="%leaderboard.column.winDrawLoss10"/>
                    <TableColumn fx:id="streakColumn" text="%leaderboard.column.streak"/>
                    <TableColumn fx:id="bestStreakColumn" text="%leaderboard.column.recordStreak"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="seasonTitleLabel" styleClass="leaderboard-season-title" visible="false" managed="false"
                   maxWidth="1.7976931348623157E308" wrapText="true"/>
            <TableView fx:id="seasonLadderTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                       onContextMenuRequested="#openSeasonContextMenu"
                       minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="seasonRankColumn" text="%leaderboard.column.rank"/>
                    <TableColumn fx:id="seasonNameColumn" text="%leaderboard.column.name"/>
                    <TableColumn fx:id="seasonPointsColumn" text="%leaderboard.column.lp"/>
                    <TableColumn fx:id="seasonGamesColumn" text="%leaderboard.column.numberOfGames"/>
                    <TableColumn fx:id="seasonMedalsColumn" text="%leaderboard.column.medals"/>
                    <TableColumn fx:id="seasonWinRateColumn" text="%leaderboard.column.winRate"/>
                    <TableColumn fx:id="seasonWdlColumn" text="%leaderboard.column.winDrawLoss"/>
                    <TableColumn fx:id="seasonWdl10Column" text="%leaderboard.column.winDrawLoss10"/>
                    <TableColumn fx:id="seasonStreakColumn" text="%leaderboard.column.streak"/>
                    <TableColumn fx:id="seasonBestStreakColumn" text="%leaderboard.column.recordStreak"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </children>
        <padding>
            <Insets top="10.0"/>
        </padding>
    </VBox>
    <VBox fx:id="connectionProgressPane" alignment="CENTER" maxHeight="1.7976931348623157E308"
          maxWidth="1.7976931348623157E308" spacing="10.0" VBox.vgrow="ALWAYS">
        <children>
            <ProgressIndicator prefHeight="80.0" prefWidth="80.0"/>
            <Label text="%leaderboard.loading">
                <VBox.margin>
                    <Insets/>
                </VBox.margin>
            </Label>
        </children>
    </VBox>
</VBox>
