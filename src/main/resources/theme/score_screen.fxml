<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="scoreScreenRoot" spacing="0.0"
      prefWidth="560.0" prefHeight="540.0" styleClass="score-screen"
      xmlns="http://javafx.com/javafx/8.0.60"
      fx:controller="com.faforever.client.ladder.ScoreScreenController">
    <!-- Banner header: report title + the viewer's own reward as the hero -->
    <VBox styleClass="score-screen-header" spacing="2.0">
        <padding>
            <Insets top="18.0" right="22.0" bottom="16.0" left="22.0"/>
        </padding>
        <Label fx:id="titleLabel" text="%scorescreen.title" styleClass="score-screen-title"/>
        <Label fx:id="stateLabel" text="%scorescreen.state.pending" styleClass="score-screen-state"/>
        <VBox fx:id="heroBox" spacing="0.0" styleClass="score-screen-hero">
            <Label fx:id="heroLpLabel" text="+0 LP" styleClass="score-screen-hero-lp"/>
            <Label fx:id="heroSubLabel" text="" styleClass="score-screen-hero-sub"/>
        </VBox>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="score-screen-scroll">
        <content>
            <VBox fx:id="rewardsContainer" styleClass="score-screen-body"/>
        </content>
    </ScrollPane>

    <HBox spacing="10.0" alignment="CENTER_RIGHT" styleClass="score-screen-actions">
        <padding>
            <Insets top="12.0" right="22.0" bottom="16.0" left="22.0"/>
        </padding>
        <Button text="%scorescreen.dontShowAgain" onAction="#onDontShowAgain" styleClass="score-screen-mute"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%close" onAction="#onClose"/>
        <Button fx:id="viewReplayButton" text="%scorescreen.viewResult" onAction="#onViewReplay"
                styleClass="score-screen-primary"/>
    </HBox>
</VBox>
