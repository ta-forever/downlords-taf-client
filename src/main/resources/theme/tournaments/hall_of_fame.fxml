<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="hallOfFameRoot"
      xmlns="http://javafx.com/javafx/19"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faforever.client.tournament.HallOfFameController">
  <HBox spacing="10.0" alignment="CENTER_LEFT">
    <padding><Insets top="8.0" bottom="8.0" left="10.0" right="10.0"/></padding>
    <Region HBox.hgrow="ALWAYS"/>
    <Label text="%hallOfFame.search.label"/>
    <TextField fx:id="searchField" promptText="%hallOfFame.search.prompt" prefWidth="180.0"/>
    <Button text="%hallOfFame.refresh" onAction="#onRefresh"/>
  </HBox>
  <StackPane VBox.vgrow="ALWAYS">
    <TableView fx:id="hallOfFameTable" styleClass="hall-of-fame-table"/>
    <Label fx:id="emptyStateLabel"
           text="%hallOfFame.empty"
           visible="false"
           managed="false"
           styleClass="hall-of-fame-empty"
           StackPane.alignment="CENTER"/>
  </StackPane>
</VBox>
