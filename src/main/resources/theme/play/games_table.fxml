<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<TableView fx:id="gamesTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faforever.client.game.GamesTableController">
  <columns>
    <TableColumn fx:id="passwordProtectionColumn" editable="false" maxWidth="30.0" minWidth="30.0" prefWidth="20.0"
                 resizable="false"/>
    <TableColumn fx:id="rankedColumn" editable="false" minWidth="30.0" maxWidth="30" prefWidth="20.0" resizable="false"/>
    <TableColumn fx:id="mapPreviewColumn" editable="false" minWidth="45.0" prefWidth="45.0" resizable="false"
                 text="%game.map"/>
    <TableColumn fx:id="modsColumn" editable="false" minWidth="70.0" prefWidth="100.0" text="%game.mods" />
    <TableColumn fx:id="statusColumn" editable="false" minWidth="80.0" prefWidth="110.0" text="%game.status" />
    <TableColumn fx:id="playersColumn" editable="false" minWidth="60.0" prefWidth="70.0" text="%game.players"/>
    <TableColumn fx:id="averageRatingColumn" editable="false" minWidth="90.0" prefWidth="105.0"
                 text="%game.averageRating"/>
    <TableColumn fx:id="ratingRangeColumn" visible="true" editable="false" minWidth="90.0" prefWidth="110.0" text="%game.ratingRange"/>
    <TableColumn fx:id="hostColumn" editable="false" minWidth="120.0" prefWidth="165.0" text="%game.host"/>
    <TableColumn fx:id="coopMissionName" editable="false" minWidth="80.0" prefWidth="120.0" text="%game.missionName"/>
    <!-- Title column goes last and has a very large maxWidth so
         CONSTRAINED_RESIZE_POLICY assigns all the remaining horizontal
         slack to it when the window grows. Game titles are the most
         readable-at-a-glance column, so they deserve the space. -->
    <TableColumn fx:id="gameTitleColumn" editable="false" minWidth="200.0" prefWidth="400.0"
                 maxWidth="1.7976931348623157E308" text="%game.title"/>
  </columns>
  <columnResizePolicy>
    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
  </columnResizePolicy>
</TableView>
