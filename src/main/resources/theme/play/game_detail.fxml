<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import com.faforever.client.fx.DefaultImageView?>
<GridPane fx:id="gameDetailRoot" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minWidth="50.0" styleClass="game-detail" vgap="10.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faforever.client.game.GameDetailController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
    </rowConstraints>
    <children>
        <StackPane fx:id="mapContainer" GridPane.columnSpan="2147483647" GridPane.halignment="CENTER">
            <DefaultImageView fx:id="mapImageView" fitWidth="230.0" fitHeight="320.0" pickOnBounds="true" preserveRatio="true" styleClass="map-preview"/>
            <AnchorPane>
                <VBox alignment="BOTTOM_LEFT" styleClass="image-dimmer" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <Label fx:id="mapLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Map&gt;" wrapText="true"/>
                    <Label fx:id="mapDescription" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Map Description&gt;"/>
                </VBox>
                <Button text="..." onMouseClicked="#onClickedMap" AnchorPane.topAnchor="5.0" AnchorPane.rightAnchor="5.0"/>
            </AnchorPane>
        </StackPane>
        <Label fx:id="gameTitleLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="game-title" text="&lt;A pretty long game title&gt;" wrapText="true" GridPane.columnSpan="2147483647" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />
        <Label fx:id="gameTypeLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Game type&gt;" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
        <Label fx:id="gameRatingTypeLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Rating Type&gt;" GridPane.rowIndex="2" GridPane.columnSpan="2">
            <graphic>
                <Region styleClass="icon,icon-trophy"/>
            </graphic>
        </Label>
        <Label fx:id="gameRatingTypeGlobalLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="%leaderboard.global.name" GridPane.rowIndex="3" GridPane.columnSpan="2"/>
        <Label fx:id="gameRatingRangeLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" wrapText="true" GridPane.rowIndex="3" GridPane.columnSpan="2">
            <graphic>
                <Region styleClass="icon,statistics-icon" />
            </graphic>
        </Label>
        <Label fx:id="gameStatusLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Map&gt;" wrapText="true" GridPane.rowIndex="4" GridPane.columnSpan="2">
            <graphic>
                <Region styleClass="icon,info-icon" />
            </graphic>
        </Label>
        <Label fx:id="gameTimeSinceStartLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Map&gt;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4"  GridPane.columnSpan="2"/>
        <Label fx:id="numberOfPlayersLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Number of players&gt;" wrapText="true" GridPane.rowIndex="5"  GridPane.columnSpan="2">
            <graphic>
                <Region styleClass="icon,players-icon" />
            </graphic>
        </Label>
        <Label fx:id="hostLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Host&gt;" wrapText="true" GridPane.rowIndex="6" GridPane.columnSpan="2">
            <graphic>
                <Region styleClass="icon,host-icon" />
            </graphic>
        </Label>
        <Label fx:id="liveReplayDelayLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" text="&lt;Number of players&gt;" wrapText="true" GridPane.rowIndex="7"  GridPane.columnSpan="2">
            <graphic>
                <Region styleClass="icon,live-tv-icon" />
            </graphic>
        </Label>
        <HBox alignment="CENTER" GridPane.columnSpan="2147483647" GridPane.rowIndex="8">
            <fx:include fx:id="watchButton" source="../vault/replay/watch_button.fxml"/>
            <Button fx:id="leaveButton" mnemonicParsing="false" onAction="#onLeaveButtonClicked" text="%game.leave" styleClass="leave-game-button"><tooltip><Tooltip text="%game.leave.tooltip"/></tooltip></Button>
            <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartButtonClicked" text="%game.start" styleClass="start-game-button"><tooltip><Tooltip text="%game.start.tooltip"/></tooltip></Button>
            <Button fx:id="manageGameButton" mnemonicParsing="false" onAction="#onManageGameClicked" text="%game.manage" styleClass="manage-game-button"><tooltip><Tooltip text="%game.manage.tooltip"/></tooltip></Button>
            <Button fx:id="joinButton" mnemonicParsing="false" onAction="#onJoinButtonClicked" text="%game.join" styleClass="join-game-button"><tooltip><Tooltip text="%game.join.tooltip"/></tooltip></Button>
            <Button fx:id="autoJoinButton" mnemonicParsing="false" onAction="#onAutoJoinButtonClicked" text="%game.autojoin" styleClass="autojoin-game-button-not-active"><tooltip><Tooltip text="%game.autojoin.tooltip"/></tooltip></Button>
        </HBox>
        <VBox fx:id="reservedPlayersContainer" maxWidth="1.7976931348623157E308" visible="false" managed="false" spacing="10.0" GridPane.columnSpan="2147483647" GridPane.rowIndex="9">
            <VBox prefWidth="200.0" spacing="10.0" styleClass="card,reserved-players-card">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="%reservedSlots.detail.title" styleClass="h3" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                    <Button fx:id="editReservedPlayersButton" mnemonicParsing="false" onAction="#onEditReservedPlayersClicked" text="%reservedSlots.detail.edit" visible="false" managed="false">
                        <tooltip><Tooltip text="%reservedSlots.detail.edit.tooltip"/></tooltip>
                    </Button>
                </HBox>
                <VBox fx:id="reservedPlayersList" maxWidth="1.7976931348623157E308" spacing="2.0"/>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
            </VBox>
            <!-- Horizontal divider between the reserved-players card and the team cards. -->
            <Separator maxWidth="1.7976931348623157E308"/>
            <padding>
                <Insets bottom="2.0" left="2.0" right="2.0" top="2.0"/>
            </padding>
        </VBox>
        <VBox alignment="BOTTOM_CENTER" fx:id="teamListPane" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS" spacing="10.0" GridPane.columnSpan="2147483647" GridPane.rowIndex="10" />
        <VBox fx:id="pingTableContainer" alignment="TOP_CENTER" maxWidth="1.7976931348623157E308" spacing="10.0" GridPane.columnSpan="2147483647" GridPane.rowIndex="11">
            <Label text="%game.detail.pingtable.title"/>
            <GridPane fx:id="pingTableGridPane" alignment="TOP_CENTER" minWidth="40" prefWidth="100" onMouseMoved="#setPingTableTooltip" onMouseExited="#hidePingTableTooltip">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES"/>
                </columnConstraints>
            </GridPane>
            <Label fx:id="pingTableValue" visible="false" alignment="CENTER_RIGHT" textAlignment="RIGHT" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</GridPane>
