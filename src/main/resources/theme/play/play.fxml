<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<StackPane fx:id="playRoot" maxHeight="1.7976931348623157E308" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faforever.client.play.PlayController">
    <HBox prefWidth="-1.0">
        <VBox fx:id="userListContainer" maxWidth="250" HBox.hgrow="NEVER"/>
        <SplitPane fx:id="mainViewContainer" dividerPositions="0.5" orientation="vertical" HBox.hgrow="ALWAYS">
            <fx:include fx:id="customGames" source="custom_games.fxml"></fx:include>
            <SplitPane fx:id="chatContainer" orientation="horizontal">
                <HBox fx:id="mainChatContainer">
                    <fx:include fx:id="mainChat" source="../chat/chat.fxml" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox fx:id="gameChatContainer">
                    <TabPane fx:id="gameChat" styleClass="chat-tab-pane" tabClosingPolicy="UNAVAILABLE" HBox.hgrow="ALWAYS"/>
                </HBox>
            </SplitPane>
        </SplitPane>
        <!-- Pin the detail panel's width with both min and pref so it
             can't be squeezed below the 250px reading width when the
             games-table column minimums sum higher than the available
             window width. Without minWidth, HBox shrinks hgrow=NEVER
             children to USE_COMPUTED_SIZE (~tiny) when the layout is
             tight, which made the panel look broken at lower resolutions.
             gameDetailWrapper.visible/managed is bound in PlayController
             to the inner ScrollPane's visible state, so the whole 250px
             column collapses when no game is selected (no empty void
             on first load). -->
        <VBox fx:id="gameDetailWrapper" minWidth="250" prefWidth="250" HBox.hgrow="NEVER">
            <ScrollPane fx:id="gameDetailContainer" fitToWidth="TRUE" minWidth="250" prefWidth="250" VBox.vgrow="ALWAYS" styleClass="game-detail-framed" />
        </VBox>
    </HBox>
</StackPane>
