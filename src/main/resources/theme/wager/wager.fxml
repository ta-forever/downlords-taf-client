<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="wagerRoot" maxHeight="1.7976931348623157E308"
      maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/8.0.60"
      fx:controller="com.faforever.client.wager.WagerController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <!-- Heading and blurb share one line; h1's 0.5em bottom padding is dropped to save a line -->
    <HBox alignment="BASELINE_LEFT" spacing="12.0">
        <Label styleClass="h1" text="%wager.title" style="-fx-padding: 0;" minWidth="-Infinity"/>
        <Label styleClass="text-secondary" text="%wager.subtitle" wrapText="true"
               HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
    </HBox>
    <Separator/>

    <!-- Resizable: left column (watchlist + my LP + my positions) | right column (selected game detail) -->
    <SplitPane orientation="HORIZONTAL" dividerPositions="0.28" VBox.vgrow="ALWAYS" styleClass="resizable-split">
        <items>
            <!-- Left column: independent collapsible sections (no resize handles between them) -->
            <VBox spacing="6.0" minWidth="200.0">
                <padding>
                    <Insets right="6.0"/>
                </padding>

                <TitledPane text="%wager.liveGames" expanded="true" VBox.vgrow="ALWAYS" collapsible="true">
                    <VBox spacing="6.0">
                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="refreshButton" text="%refresh"/>
                        </HBox>
                        <ListView fx:id="gamesList" VBox.vgrow="ALWAYS" prefHeight="200.0"/>
                    </VBox>
                </TitledPane>

                <Separator/>

                <TitledPane text="%wager.myLadderPoints" expanded="true" collapsible="true">
                    <ListView fx:id="myLpList" prefHeight="160.0"/>
                </TitledPane>

                <Separator/>

                <TitledPane text="%wager.bot.title" expanded="false" collapsible="true">
                    <fx:include fx:id="botPnl" source="wager_bot_pnl.fxml"/>
                </TitledPane>

                <Separator/>

                <!-- My positions (portfolio) — kept in the left column so the right column gets full height -->
                <TitledPane text="%wager.portfolio" expanded="true" VBox.vgrow="ALWAYS" collapsible="true">
                    <TableView fx:id="portfolioTable" prefHeight="160.0">
                        <columns>
                            <TableColumn fx:id="posGameColumn" text="%wager.column.game"/>
                            <TableColumn fx:id="posStatusColumn" text="%wager.column.status"/>
                            <TableColumn fx:id="posMarketColumn" text="%wager.column.position"/>
                            <TableColumn fx:id="posSharesColumn" text="%wager.column.shares"/>
                            <TableColumn fx:id="posCostColumn" text="%wager.column.cost"/>
                            <TableColumn fx:id="posValueColumn" text="%wager.column.value"/>
                            <TableColumn fx:id="posPnlColumn" text="%wager.column.pnl"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </TitledPane>
            </VBox>

            <!-- Right column: selected game detail (full height) -->
            <VBox spacing="8.0" minWidth="360.0">
                <padding>
                    <Insets left="6.0"/>
                </padding>
                <Label fx:id="boardLabel" styleClass="text-secondary"/>
                <Label fx:id="marketStatusLabel" styleClass="text-secondary"/>

                <Separator/>

                <!-- Map thumbnail + team cards -->
                <HBox spacing="10.0" alignment="TOP_LEFT" minHeight="145.0">
                    <VBox alignment="TOP_CENTER" spacing="4.0" minWidth="110.0">
                        <ImageView fx:id="mapImageView" fitWidth="100.0" fitHeight="100.0" preserveRatio="true"/>
                        <Label fx:id="mapNameLabel" styleClass="text-secondary" wrapText="true"
                               maxWidth="110.0" alignment="CENTER"/>
                    </VBox>
                    <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" minHeight="145.0"
                                styleClass="no-border" HBox.hgrow="ALWAYS">
                        <HBox fx:id="teamCardsPane" spacing="10.0"/>
                    </ScrollPane>
                </HBox>

                <Separator/>

                <!-- Outcome picker (drives which team you trade) -->
                <TableView fx:id="outcomesTable" prefHeight="145.0" minHeight="115.0">
                    <columns>
                        <TableColumn fx:id="outcomeColumn" text="%wager.column.outcome"/>
                        <TableColumn fx:id="priceColumn" text="%wager.column.price"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <Separator/>

                <!-- Buy by amount (LP to spend, fee incl.) -> shares -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="%wager.buyFor" minWidth="55.0"/>
                    <TextField fx:id="lpField" prefWidth="90.0" promptText="%wager.lp"/>
                    <Label text="%wager.lp"/>
                    <Button fx:id="buyButton" styleClass="primary-button" text="%wager.buy"/>
                    <Label fx:id="buyPreviewLabel" styleClass="text-secondary"/>
                </HBox>
                <!-- Sell by share count -> LP received (fee deducted) -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="%wager.sellLabel" minWidth="55.0"/>
                    <TextField fx:id="sharesField" prefWidth="90.0" promptText="%wager.shares"/>
                    <Button fx:id="maxButton" text="%wager.max"/>
                    <Button fx:id="sellButton" text="%wager.sell"/>
                    <Label fx:id="sellPreviewLabel" styleClass="text-secondary"/>
                </HBox>
                <Label fx:id="tradeStatusLabel" styleClass="text-secondary"/>

                <Separator/>

                <!-- price chart for the selected outcome -->
                <LineChart fx:id="priceChart" VBox.vgrow="ALWAYS" minHeight="160.0" legendVisible="true"
                           createSymbols="false" animated="false" styleClass="price-chart"
                           horizontalGridLinesVisible="true">
                    <xAxis>
                        <NumberAxis label="%wager.chart.time" forceZeroInRange="false"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="%wager.chart.price" lowerBound="0" upperBound="100"
                                    autoRanging="false" tickUnit="20"/>
                    </yAxis>
                </LineChart>
            </VBox>
        </items>
    </SplitPane>
</VBox>
