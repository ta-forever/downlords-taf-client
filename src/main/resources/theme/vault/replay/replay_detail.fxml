<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitMenuButton?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import javafx.scene.control.Tooltip?>
<?import com.faforever.client.fx.DefaultImageView?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="replayDetailRoot" onMouseClicked="#onDimmerClicked"
            styleClass="dimmer" xmlns="http://javafx.com/javafx/8.0.121"
            fx:controller="com.faforever.client.replay.ReplayDetailController">
   <children>
       <AnchorPane onMouseClicked="#onContentPaneClicked" styleClass="modal-popup" AnchorPane.bottomAnchor="50.0"
                   AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
         <children>
             <ScrollPane fx:id="scrollPane" fitToWidth="true" layoutX="21.0" layoutY="31.0"
                         AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0"
                         AnchorPane.topAnchor="20.0">
               <content>
                   <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                         spacing="20.0">
                     <children>
                         <GridPane hgap="20.0" vgap="10.0">
                           <columnConstraints>
                               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                               <ColumnConstraints hgrow="NEVER" minWidth="10.0"/>
                               <ColumnConstraints hgrow="NEVER" minWidth="10.0"/>
                               <ColumnConstraints hgrow="NEVER" minWidth="10.0"/>
                               <ColumnConstraints hgrow="NEVER" minWidth="10.0"/>
                               <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"/>
                           </columnConstraints>
                           <rowConstraints>
                               <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                               <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                               <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                               <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                           </rowConstraints>
                           <children>
                               <DefaultImageView fx:id="mapThumbnailImageView" fitHeight="128.0" fitWidth="128.0"
                                                 pickOnBounds="true" preserveRatio="true" GridPane.rowSpan="2147483647"
                                                 GridPane.valignment="TOP"/>
                               <Label fx:id="titleLabel" maxWidth="1.7976931348623157E308" styleClass="h1"
                                      text="&lt;Title&gt;" GridPane.columnIndex="1" GridPane.columnSpan="2147483647"
                                      GridPane.valignment="TOP"/>
                               <Label fx:id="dateLabel" graphicTextGap="10.0" text="&lt;Date&gt;"
                                      GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <graphic>
                                     <Region styleClass="icon,date-icon"/>
                                 </graphic>
                              </Label>
                               <Label fx:id="timeLabel" graphicTextGap="10.0" text="&lt;Time&gt;"
                                      GridPane.columnIndex="2" GridPane.rowIndex="2">
                                 <graphic>
                                     <Region styleClass="icon,time-icon"/>
                                 </graphic>
                              </Label>
                               <Label fx:id="durationLabel" graphicTextGap="10.0" text="&lt;Duration&gt;"
                                      GridPane.columnIndex="3" GridPane.rowIndex="2">
                                   <graphic>
                                       <Region styleClass="icon,duration-icon"/>
                                   </graphic>
                               </Label>
                               <HBox spacing="5.0" alignment="CENTER_LEFT"
                                     GridPane.columnIndex="1" GridPane.rowIndex="3">
                                   <Label fx:id="modLabel" graphicTextGap="10.0" text="&lt;Mods&gt;">
                                     <graphic>
                                         <Region styleClass="icon,mods-icon"/>
                                     </graphic>
                                  </Label>
                                   <Label fx:id="modVersionLabel" text="&lt;ModVersion&gt;">
                                     <tooltip><Tooltip text="%replay.modVersionTooltip"/></tooltip>
                                  </Label>
                               </HBox>
                               <Label fx:id="ratingTypeLabel" graphicTextGap="10.0"
                                      GridPane.columnIndex="2" GridPane.rowIndex="3">
                                   <graphic>
                                       <Region styleClass="icon, icon-trophy"/>
                                   </graphic>
                               </Label>
                               <Label fx:id="qualityLabel" graphicTextGap="10.0" text="&lt;Quality&gt;"
                                      GridPane.columnIndex="3" GridPane.rowIndex="3">
                                 <graphic>
                                     <Region styleClass="icon,balance-icon"/>
                                 </graphic>
                              </Label>
                               <Label fx:id="ratingLabel" graphicTextGap="10.0" text="&lt;AvgRating&gt;"
                                      GridPane.columnIndex="4" GridPane.rowIndex="3">
                                   <graphic>
                                       <Region styleClass="icon,statistics-icon"/>
                                   </graphic>
                               </Label>
                               <HBox spacing="10"
                                     GridPane.fillWidth="false"
                                     GridPane.halignment="RIGHT" GridPane.columnSpan="2147483647"
                                     GridPane.rowIndex="4" GridPane.columnIndex="5">
                                   <Button fx:id="unhideButton" onAction="#onUnhideButton" text="%replay.unhide">
                                       <graphic><Region styleClass="icon,visibility-on-icon"/></graphic>
                                   </Button>
                                   <HBox fx:id="replayAvailableContainer" spacing="10">
                                       <Button fx:id="tadaUploadButton" mnemonicParsing="false"
                                               onAction="#onTadaUploadButtonClicked" text="TADA">
                                           <tooltip><Tooltip text="%tada.upload.tooltip" /></tooltip>
                                           <graphic>
                                               <Region styleClass="icon,upload-icon"/>
                                           </graphic>
                                       </Button>
                                       <SplitMenuButton fx:id="downloadButton" styleClass="replay-download-button"
                                                        mnemonicParsing="false"
                                                        onAction="#onDownloadButtonClicked" text="%replay.download">
                                           <items>
                                               <CheckMenuItem fx:id="downloadIncludeDateMenuItem"
                                                              text="%replay.download.includeDate" />
                                               <CheckMenuItem fx:id="downloadIncludeModMenuItem"
                                                              text="%replay.download.includeMod" />
                                               <CheckMenuItem fx:id="downloadIncludeMapMenuItem"
                                                              text="%replay.download.includeMap" />
                                               <CheckMenuItem fx:id="downloadIncludePlayersMenuItem"
                                                              text="%replay.download.includePlayers" />
                                           </items>
                                           <graphic>
                                               <Region styleClass="icon,download-icon"/>
                                           </graphic>
                                       </SplitMenuButton>
                                       <Button fx:id="watchButton" defaultButton="true" mnemonicParsing="false"
                                               onAction="#onWatchButtonClicked" text="%game.watchButtonFormat">
                                           <graphic>
                                               <Region styleClass="icon,play-icon"/>
                                           </graphic>
                                       </Button>
                                   </HBox>
                               </HBox>
                               <Label fx:id="onMapLabel" styleClass="secondary" text="&lt;OnMap&gt;"
                                      GridPane.columnIndex="1" GridPane.columnSpan="2147483647" GridPane.rowIndex="1"
                                      GridPane.valignment="TOP"/>
                               <HBox alignment="TOP_RIGHT" prefWidth="100.0" GridPane.columnIndex="1" spacing="10"
                                     GridPane.columnSpan="2147483647">
                                   <children>
                                       <Label fx:id="visibilityLabel">
                                           <graphic><Region styleClass="icon,visibility-off-icon"/></graphic>
                                       </Label>
                                       <TextField fx:id="replayIdField" alignment="CENTER_RIGHT" editable="false"
                                                  maxWidth="100.0" promptText="&lt;ReplayID&gt;" text="#123456789"/>
                                       <Button fx:id="copyButton" onAction="#copyLink"
                                               prefHeight="25.0" text="Copy link for chat"/>
                                   </children>
                               </HBox>
                           </children>
                           <VBox.margin>
                               <Insets/>
                           </VBox.margin>
                        </GridPane>
                         <Separator maxWidth="1.7976931348623157E308"/>
                         <HBox fx:id="teamsInfoBox" alignment="CENTER_LEFT" spacing="10.0">
                             <children>
                                 <Label maxWidth="1.7976931348623157E308" styleClass="h2" text="%game.lineUp"
                                        HBox.hgrow="ALWAYS"/>
                                 <fx:include fx:id="displayMetricToggle" source="../../display_metric_toggle.fxml"/>
                                 <ToggleButton fx:id="viewBattleReportButton" alignment="CENTER" mnemonicParsing="false"
                                         onAction="#onViewBattleReport" text="%scorescreen.viewBattleReport"/>
                                 <Label fx:id="notRatedReasonLabel" alignment="CENTER"/>
                             </children>
                         </HBox>
                         <HBox fx:id="teamsContainer" alignment="TOP_CENTER" spacing="20.0"/>
                         <VBox fx:id="combatRewardsContainer" alignment="TOP_CENTER" maxWidth="640.0" spacing="4.0"
                               managed="false" visible="false">
                           <VBox.margin>
                             <Insets top="10.0"/>
                           </VBox.margin>
                         </VBox>
                         <TitledPane fx:id="wagerChartPane" animated="false" expanded="false"
                                     maxWidth="640.0" text="%replay.wagerChart.title"
                                     visible="false" managed="false">
                           <VBox.margin>
                             <Insets top="10.0"/>
                           </VBox.margin>
                           <VBox alignment="TOP_CENTER" spacing="4.0">
                             <Label fx:id="wagerChartPlaceholder" styleClass="text-secondary"
                                    text="%replay.wagerChart.none" wrapText="true"/>
                             <LineChart fx:id="wagerPriceChart" animated="false" createSymbols="false"
                                        legendVisible="true" managed="false" minHeight="180.0" visible="false"
                                        styleClass="price-chart" horizontalGridLinesVisible="true">
                               <xAxis>
                                 <NumberAxis label="%replay.wagerChart.xAxis" side="BOTTOM"/>
                               </xAxis>
                               <yAxis>
                                 <NumberAxis autoRanging="false" label="%replay.wagerChart.yAxis"
                                             lowerBound="0.0" upperBound="1.0" tickUnit="0.25" side="LEFT"/>
                               </yAxis>
                             </LineChart>
                             <!-- per-trader colour legend for the ▲/▼ trade markers on the chart -->
                             <FlowPane fx:id="wagerChartLegend" hgap="12.0" vgap="4.0" alignment="CENTER"
                                       visible="false" managed="false"/>
                             <!-- per-trader realised P&L over the game's resolved markets -->
                             <VBox fx:id="wagerPnlBox" spacing="2.0" maxWidth="360.0"
                                   visible="false" managed="false"/>
                           </VBox>
                         </TitledPane>
                         <HBox alignment="CENTER_RIGHT">
                             <Button fx:id="reportButton" alignment="CENTER_RIGHT" mnemonicParsing="false"
                                     onAction="#onReport" text="%game.report"/>
                         </HBox>
                         <Separator fx:id="ratingSeparator" layoutX="10.0" layoutY="251.0"
                                    maxWidth="1.7976931348623157E308"/>
                         <VBox fx:id="reviewsContainer" alignment="TOP_CENTER" maxWidth="640.0">
                             <children>
                                 <fx:include fx:id="reviews" source="../review/reviews.fxml"/>
                             </children>
                         </VBox>
                         <Separator fx:id="reviewSeparator" layoutX="10.0" layoutY="254.0"
                                    maxWidth="1.7976931348623157E308" visible="false" managed="false"/>
                         <!-- Game Options + Chat are hidden. -->
                         <VBox fx:id="moreInformationPane" maxWidth="1.7976931348623157E308"
                               visible="false" managed="false">
                             <children>
                                 <GridPane hgap="10.0" maxWidth="1.7976931348623157E308" vgap="10.0">
                                     <columnConstraints>
                                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                                         <ColumnConstraints hgrow="NEVER" minWidth="1.0"/>
                                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                                     </columnConstraints>
                                     <rowConstraints>
                                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                         <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                     </rowConstraints>
                                     <children>
                                         <TableView fx:id="optionsTable" maxWidth="1.7976931348623157E308"
                                                    GridPane.rowIndex="1">
                                             <columns>
                                                 <TableColumn fx:id="optionKeyColumn" editable="false" prefWidth="75.0"
                                                              text="%game.optionKey"/>
                                                 <TableColumn fx:id="optionValueColumn" editable="false"
                                                              prefWidth="75.0" text="%game.optionValue"/>
                                             </columns>
                                             <columnResizePolicy>
                                                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                             </columnResizePolicy>
                                         </TableView>
                                         <TableView fx:id="chatTable" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                             <columns>
                                                 <TableColumn fx:id="chatGameTimeColumn" editable="false"
                                                              maxWidth="1000.0" text="%game.chat.gameTime"/>
                                                 <TableColumn fx:id="chatSenderColumn" editable="false"
                                                              maxWidth="1000.0" sortable="false"
                                                              text="%game.chat.sender"/>
                                                 <TableColumn fx:id="chatMessageColumn" editable="false"
                                                              prefWidth="200.0" sortable="false"
                                                              text="%game.chat.message"/>
                                             </columns>
                                             <columnResizePolicy>
                                                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                             </columnResizePolicy>
                                         </TableView>
                                         <Label styleClass="h2" text="%game.options"/>
                                         <Label styleClass="h2" text="%game.chat" GridPane.columnIndex="2"/>
                                         <Separator orientation="VERTICAL" prefHeight="200.0" GridPane.columnIndex="1"
                                                    GridPane.rowIndex="1"/>
                                     </children>
                                 </GridPane>
                             </children>
                         </VBox>
                     </children>
                     <padding>
                         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
             <Button cancelButton="true" focusTraversable="false" onAction="#onCloseButtonClicked"
                        AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <graphic>
                    <Region styleClass="icon,close-icon"/>
                </graphic>
                <styleClass>
                   <String fx:value="window-button"/>
                   <String fx:value="close-button"/>
               </styleClass>
             </Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
