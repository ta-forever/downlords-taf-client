<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/8.0.141"
           fx:id="rootPane"
           fx:controller="com.faforever.client.galacticwar.GalaxyViewController">
    <GridPane>
        <columnConstraints>
            <!-- minWidth 0: everything left of the planet detail must be able to shrink away, so that
                 narrowing the window never pushes the fixed-width detail column off the right edge. -->
            <ColumnConstraints hgrow="ALWAYS" minWidth="0"/>
            <ColumnConstraints minWidth="240" prefWidth="240" maxWidth="240"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>

        <SplitPane dividerPositions="0.25"
                   minWidth="0"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0">

            <!-- LEFT: Leaderboard -->
            <VBox spacing="6" minWidth="48" maxWidth="400" prefWidth="280" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                <Label fx:id="leaderboardTitle" text="%leaderboard.displayName" styleClass="h1"/>
                <CheckBox fx:id="leaderboardWarXpToggle"
                          text="%galacticWar.leaderboard.thisWar"
                          onAction="#onLeaderboardXpModeToggled"/>
                <ScrollPane fitToWidth="true"
                            fitToHeight="true"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="leaderboardContainer"
                              spacing="4"/>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- RIGHT: Map + Reset button -->
            <StackPane minWidth="0">
                <Region styleClass="galactic-war-background"/>
                <StackPane minWidth="0">
                    <ScrollPane fx:id="galacticWarGraphContainer"
                                fitToWidth="true"
                                fitToHeight="true"
                                minWidth="0"/>

                    <!-- FlowPane rather than HBox: it is stretched to the full width of the map area
                         (maxWidth=Infinity) and wraps, so when the window is too narrow for one row the
                         buttons stack into further rows - down to one per row, i.e. vertically - instead
                         of overflowing past the right hand edge. minWidth=0 keeps the button row from
                         setting a floor on the width of the whole view. -->
                    <javafx.scene.layout.FlowPane fx:id="galaxyToolbar"
                                                  orientation="HORIZONTAL"
                                                  hgap="6" vgap="6"
                                                  alignment="TOP_RIGHT"
                                                  StackPane.alignment="TOP_RIGHT"
                                                  pickOnBounds="false"
                                                  minWidth="0" maxWidth="Infinity" maxHeight="-Infinity">
                        <padding>
                            <Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/>
                        </padding>
                        <Button text="%galacticWar.hallOfVictors"
                                onAction="#onHallOfVictorsButtonPressed"/>
                        <Button text="%galacticWar.guide"
                                onAction="#onGuideButtonPressed"/>
                        <Button text="%galacticWar.settings"
                                onAction="#onSettingsButtonPressed"/>
                        <Button text="%galactic_war.view.reset"
                                onAction="#resetView"
                                styleClass="reset-view-button"/>
                    </javafx.scene.layout.FlowPane>
                </StackPane>
            </StackPane>
        </SplitPane>

        <!-- FIXED RIGHT PANEL -->
        <VBox fx:id="planetDetailContainer"
              GridPane.columnIndex="1"
              GridPane.rowIndex="0"/>

    </GridPane>

    <!-- Loading overlay -->
    <Label fx:id="loadingIndicator"
           text="%loading"
           contentDisplay="TOP">
        <graphic>
            <ProgressIndicator maxWidth="80" maxHeight="80"/>
        </graphic>
    </Label>

    <!-- Victory splash overlay: shown once per galaxy iteration when the war has been won.
         Backdrop art is chosen per winning faction by the controller; the translucent
         Region keeps title text readable over the art. -->
    <!-- minWidth/minHeight 0 is load-bearing, not cosmetic: the controller binds
         victoryBackgroundImage's fitWidth/fitHeight to this pane's own width/height, and an ImageView
         is not resizable, so its *minimum* size is whatever fit size it currently has. Without these
         overrides the overlay's minimum ratchets up to the largest size the window has ever had, that
         minimum propagates to rootPane and out through the tab content region, and the whole view can
         then never shrink again - un-maximising pushed the planet detail and the toolbar off the
         right hand edge. The overlay is purely decorative, so it must never drive the layout minimum. -->
    <StackPane fx:id="victoryOverlay"
               visible="false"
               minWidth="0" minHeight="0"
               style="-fx-background-color: black;">
        <ImageView fx:id="victoryBackgroundImage"/>
        <Region style="-fx-background-color: rgba(0,0,0,0.35);"/>
        <VBox alignment="CENTER" spacing="18" maxWidth="700">
            <ImageView fx:id="victoryFactionImage" fitWidth="200" preserveRatio="true"/>
            <Label fx:id="victoryTitle"
                   wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 2.4em; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="victorySubtitle"
                   wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 1.2em; -fx-text-fill: #cccccc;"/>
            <Label fx:id="victoryMvps"
                   wrapText="true" textAlignment="CENTER"
                   style="-fx-text-fill: #cccccc;"/>
            <!-- Per-faction top-5 placements with medal markers; populated in code -->
            <javafx.scene.layout.HBox fx:id="victoryHonours" alignment="CENTER" spacing="56"/>
            <Button text="%galacticWar.victory.dismiss"
                    onAction="#onVictoryDismissed"/>
        </VBox>
    </StackPane>
</StackPane>
