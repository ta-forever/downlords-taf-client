<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.StackedBarChart?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import com.faforever.client.fx.ScatterXChart?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.FlowPane?>
<VBox fx:id="userInfoRoot" prefHeight="700.0" prefWidth="900.0" styleClass="user-info-window" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faforever.client.chat.UserInfoWindowController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="user-info-header-area">
         <children>
          <ImageView fx:id="featuredMedalImageView" fitWidth="40.0" fitHeight="40.0" pickOnBounds="true"
                     preserveRatio="true" visible="false" managed="false" styleClass="featured-medal"/>
          <Label fx:id="usernameLabel" maxWidth="1.7976931348623157E308" styleClass="h1" text="&lt;Username&gt;" />
            <Label fx:id="countryLabel" text="&lt;Country&gt;">
            <graphic>
                <ImageView fx:id="countryImageView" pickOnBounds="true" preserveRatio="true" />
            </graphic>
          </Label>
          <Region HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
          <fx:include source="display_metric_toggle.fxml"/>
         </children>
         <padding>
            <Insets left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
      <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
      <tabs>
        <Tab text="%userInfo.general">
          <content>
              <ScrollPane fitToHeight="true" fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
              <content>
                <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0">
                  <children>
                    <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
                        </rowConstraints>
                        <children>
                            <GridPane prefWidth="250.0" styleClass="card">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints minHeight="10.0" vgrow="NEVER"/>
                                    <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
                                    <RowConstraints minHeight="10.0" vgrow="NEVER"/>
                                </rowConstraints>
                                <children>
                                    <Label styleClass="h2" text="%userInfo.gamesPlayed"/>
                                    <Label fx:id="gamesPlayedLabel" alignment="CENTER" maxWidth="1.7976931348623157E308"
                                           prefHeight="80.0" styleClass="h1" text="000" GridPane.rowIndex="1"/>
                                    <Label fx:id="resultsBreakdownLabel" alignment="CENTER" maxWidth="1.7976931348623157E308"
                                           prefHeight="15.0" styleClass="h3" text="000" GridPane.rowIndex="2"/>
                                </children>
                                <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                                </padding>
                            </GridPane>
                            <HBox fx:id="ratingsBox" styleClass="card" GridPane.columnIndex="1"
                                  GridPane.halignment="CENTER"
                                  alignment="CENTER" spacing="10.0">
                                <Label fx:id="ratingsLabels" textAlignment="CENTER" styleClass="h2"
                                       text="&lt;rating names&gt;"/>
                                <Label fx:id="ratingsValues" textAlignment="CENTER" maxWidth="1.7976931348623157E308"
                                       styleClass="h2" text="&lt;rating values&gt;" GridPane.rowIndex="1"/>
                            </HBox>
                            <VBox styleClass="card" GridPane.columnSpan="2147483647" GridPane.rowIndex="2">
                                <padding>
                                    <Insets right="15.0"/>
                                </padding>
                                <children>
                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <padding>
                                            <Insets top="10.0"/>
                                        </padding>
                                        <children>
                                            <Label fx:id="recordScoreLabel" alignment="CENTER" maxWidth="1.7976931348623157E308"
                                                   prefHeight="15.0" styleClass="h3" text="000"/>
                                            <ComboBox fx:id="ratingMetricComboBox" onAction="#plotPlayerRatingGraph"/>
                                            <ComboBox fx:id="timePeriodComboBox" onAction="#plotPlayerRatingGraph"/>
                                            <ComboBox fx:id="ratingTypeComboBox" onAction="#onRatingTypeChange"/>
                                        </children>
                                    </HBox>

                                    <ScatterXChart fx:id="ratingHistoryChart" legendVisible="false"
                                                   prefHeight="300.0" VBox.vgrow="ALWAYS">
                                        <xAxis>
                                            <NumberAxis forceZeroInRange="false" autoRanging="false" side="BOTTOM"
                                                        fx:id="xAxis"/>
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="yAxis" forceZeroInRange="false" side="LEFT"/>
                                        </yAxis>
                                    </ScatterXChart>
                                    <VBox fx:id="loadingHistoryPane" alignment="CENTER"
                                          maxHeight="1.7976931348623157E308"
                                          maxWidth="1.7976931348623157E308" mouseTransparent="true" spacing="10.0">
                                        <Label text="%vault.loading">
                                            <graphic>
                                                <ProgressIndicator/>
                                            </graphic>
                                        </Label>
                                    </VBox>
                                </children>
                        </VBox>
                      </children>
                    </GridPane>
                  </children>
                  <padding>
                      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
                </VBox>
              </content>
            </ScrollPane>
          </content>
          <graphic>
              <Region styleClass="icon,info-icon" />
          </graphic>
        </Tab>
        <Tab text="%userInfo.statistics">
          <content>
            <ScrollPane fitToWidth="true">
              <content>
                <GridPane hgap="10.0" vgap="10.0">
                  <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                  </columnConstraints>
                  <rowConstraints>
                      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                  </rowConstraints>
                  <children>
                    <VBox styleClass="card" visible="false" managed="false">
                      <children>
                          <StackedBarChart fx:id="factionsChart" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" title="%userInfo.winLossPerFaction">
                          <xAxis>
                              <CategoryAxis fx:id="factionsCategoryAxis" side="BOTTOM" />
                          </xAxis>
                          <yAxis>
                              <NumberAxis fx:id="factionsNumberAxis" side="LEFT" />
                          </yAxis>
                        </StackedBarChart>
                      </children>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </VBox>
                    <VBox styleClass="card" visible="false" managed="false">
                      <children>
                          <PieChart fx:id="unitsBuiltChart" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" title="%userInfo.builtByCategory" />
                      </children>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </VBox>
                    <VBox styleClass="card" visible="false" managed="false">
                      <children>
                          <PieChart fx:id="techBuiltChart" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" title="%userInfo.builtByTech" />
                      </children>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </VBox>
                    <VBox styleClass="card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                      <children>
                          <PieChart fx:id="gamesPlayedByModChart" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" title="%userInfo.gamesPlayedByMod" />
                      </children>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </VBox>
                    <VBox styleClass="card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <children>
                            <PieChart fx:id="gamesPlayedByLeaderboardChart" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" title="%userInfo.gamesPlayedByLeaderboard" />
                        </children>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </VBox>
                      <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                          <children>
                              <TableView fx:id="ratingTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                         minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                                  <columns>
                                      <TableColumn fx:id="ratingTableLeaderboardnameColumn" text="%leaderboard.displayName"/>
                                      <TableColumn fx:id="ratingTableRatingColumn" text="%leaderboard.column.rating"/>
                                      <TableColumn fx:id="ratingTableGamesPlayedColumn" text="%leaderboard.column.numberOfGames"/>
                                      <TableColumn fx:id="ratingTableWinRateColumn" text="%leaderboard.column.winRate"/>
                                      <TableColumn fx:id="ratingTableAllResultsColumn" text="%leaderboard.column.winDrawLoss"/>
                                      <TableColumn fx:id="ratingTableRecentResultsColumn" text="%leaderboard.column.winDrawLoss10"/>
                                      <TableColumn fx:id="ratingTableStreakColumn" text="%leaderboard.column.streak"/>
                                      <TableColumn fx:id="ratingTableBestStreakColumn" text="%leaderboard.column.recordStreak"/>
                                  </columns>
                                  <columnResizePolicy>
                                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                  </columnResizePolicy>
                              </TableView>
                              <!-- Season Ladder mode: same columns but season-scoped, Rating -> Ladder Points. -->
                              <TableView fx:id="seasonStatsTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                         minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS" visible="false" managed="false">
                                  <columns>
                                      <TableColumn fx:id="seasonStatsBoardColumn" text="%leaderboard.displayName"/>
                                      <TableColumn fx:id="seasonStatsRankColumn" text="%leaderboard.column.rank"/>
                                      <TableColumn fx:id="seasonStatsPointsColumn" text="%leaderboard.column.lp"/>
                                      <TableColumn fx:id="seasonStatsGamesColumn" text="%leaderboard.column.numberOfGames"/>
                                      <TableColumn fx:id="seasonStatsWinRateColumn" text="%leaderboard.column.winRate"/>
                                      <TableColumn fx:id="seasonStatsWdlColumn" text="%leaderboard.column.winDrawLoss"/>
                                      <TableColumn fx:id="seasonStatsWdl10Column" text="%leaderboard.column.winDrawLoss10"/>
                                      <TableColumn fx:id="seasonStatsStreakColumn" text="%leaderboard.column.streak"/>
                                      <TableColumn fx:id="seasonStatsBestStreakColumn" text="%leaderboard.column.recordStreak"/>
                                  </columns>
                                  <columnResizePolicy>
                                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                  </columnResizePolicy>
                              </TableView>
                          </children>
                          <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                          </padding>
                      </VBox>
                  </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </GridPane>
              </content>
            </ScrollPane>
          </content>
          <graphic>
              <Region styleClass="icon,statistics-icon" />
          </graphic>
        </Tab>

        <Tab fx:id="medalCabinetTab" closable="false" text="%userInfo.medalCabinet">
          <content>
            <ScrollPane fitToWidth="true">
              <content>
                <VBox>
                  <children>
                    <VBox fx:id="ladderMedalCabinetCard" styleClass="card,medal-cabinet-card"
                          visible="false" managed="false">
                        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
                        <Label text="%userInfo.medalCabinet" styleClass="h2"/>
                        <VBox fx:id="ladderMedalCabinet" styleClass="medal-cabinet" spacing="8.0"/>
                    </VBox>
                  </children>
                  <padding>
                      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
                </VBox>
              </content>
            </ScrollPane>
          </content>
          <graphic>
              <Region styleClass="icon,star-icon" />
          </graphic>
        </Tab>

          <Tab closable="false" text="%userInfo.achievements">
              <content>
                  <VBox>
                      <children>
                          <Label fx:id="loadingProgressLabel" alignment="CENTER" contentDisplay="TOP" graphicTextGap="10.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%achievements.loading" VBox.vgrow="ALWAYS">
                              <graphic>
                                  <ProgressIndicator prefHeight="50.0" prefWidth="50.0"/>
                              </graphic>
                          </Label>
                          <ScrollPane fx:id="achievementsPane" fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
                              <content>
                                  <VBox alignment="TOP_CENTER" maxWidth="1.7976931348623157E308" spacing="10.0">
                                      <children>
                                          <GridPane fx:id="mostRecentAchievementPane" hgap="20.0" VBox.vgrow="NEVER">
                                              <columnConstraints>
                                                  <ColumnConstraints hgrow="NEVER" />
                                                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
                                              </columnConstraints>
                                              <rowConstraints>
                                                  <RowConstraints vgrow="NEVER" />
                                                  <RowConstraints vgrow="NEVER" />
                                                  <RowConstraints vgrow="NEVER" />
                                                  <RowConstraints vgrow="ALWAYS" />
                                                  <RowConstraints vgrow="NEVER" />
                                                  <RowConstraints vgrow="NEVER" />
                                              </rowConstraints>
                                              <children>
                                                  <ImageView fx:id="mostRecentAchievementImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" GridPane.rowSpan="3" />
                                                  <Label text="%achievements.mostRecent" GridPane.columnIndex="1" />
                                                  <Label fx:id="mostRecentAchievementNameLabel" styleClass="achievement-title" text="&lt;Title&gt;" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="TOP" />
                                                  <Label fx:id="mostRecentAchievementDescriptionLabel" text="&lt;Description&gt;" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.valignment="TOP" />
                                              </children>
                                          </GridPane>
                                          <HBox fx:id="unlockedAchievementsHeader" alignment="CENTER" spacing="10.0">
                                              <children>
                                                  <Separator HBox.hgrow="ALWAYS" />
                                                  <Label fx:id="unlockedAchievementsHeaderLabel" styleClass="h1" text="%achievements.unlocked" />
                                                  <Separator HBox.hgrow="ALWAYS" />
                                              </children>
                                              <VBox.margin>
                                                  <Insets top="20.0" />
                                              </VBox.margin>
                                          </HBox>
                                          <FlowPane fx:id="unlockedAchievementsContainer" alignment="TOP_CENTER" hgap="10.0" maxWidth="1.7976931348623157E308" vgap="10.0" />
                                          <HBox fx:id="lockedAchievementsHeader" alignment="CENTER" spacing="10.0">
                                              <children>
                                                  <Separator HBox.hgrow="ALWAYS" />
                                                  <Label fx:id="lockedAchievementsHeaderLabel" styleClass="h1" text="%achievements.locked" />
                                                  <Separator HBox.hgrow="ALWAYS" />
                                              </children>
                                              <VBox.margin>
                                                  <Insets top="20.0" />
                                              </VBox.margin>
                                          </HBox>
                                          <FlowPane fx:id="lockedAchievementsContainer" alignment="TOP_CENTER" hgap="10.0" maxWidth="1.7976931348623157E308" vgap="10.0">
                                              <VBox.margin>
                                                  <Insets />
                                              </VBox.margin>
                                          </FlowPane>
                                      </children>
                                      <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                      </padding>
                                  </VBox>
                              </content>
                          </ScrollPane>
                      </children>
                      <padding>
                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                      </padding>
                  </VBox>
              </content>
              <graphic>
                  <Region styleClass="icon,icon-trophy" />
              </graphic>
          </Tab>



        <Tab closable="false" text="%userInfo.nameHistory">
            <content>
                <TableView fx:id="nameHistoryTable">
                    <placeholder>
                        <Label text="%userInfo.nameHistory.noHistory" />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="changeDateColumn" editable="false" prefWidth="150" text="%userInfo.nameHistory.date" />
                        <TableColumn fx:id="nameColumn" editable="false" prefWidth="150" text="%userInfo.nameHistory.name" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                   <padding>
                      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                   </padding>
                </TableView>
            </content>
            <graphic>
                <Region styleClass="icon,icon-history" />
            </graphic>
        </Tab>
      </tabs>
    </TabPane>
   </children>
</VBox>
